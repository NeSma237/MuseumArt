 lewa7 mn Metropolitan Museum of Art Open Access API\nويحمل الصور + يبني الـ Knowledge Base (JSON) اللي هنستخدمه في الـ RAG\n\nاستخدميه في Colab أو لوكال - مفيش حاجة تتنزل غير requests (متاحة افتراضيًا)\n\"\"\"\n\nimport requests\nimport os\nimport json\nimport time\n\n# ============ الإعدادات ============\nNUM_ARTWORKS = 50          # عدد اللوحات المطلوبة\nDEPARTMENT_ID = 11         # 11 = European Paintings (فيها لوحات مشهورة كتير)\nSEARCH_QUERY = \"painting\"  # كلمة البحث\nOUTPUT_DIR = \"artmuse_data\"\nIMAGES_DIR = os.path.join(OUTPUT_DIR, \"images\")\nJSON_PATH = os.path.join(OUTPUT_DIR, \"artworks.json\")\n\nBASE_URL = \"https://collectionapi.metmuseum.org/public/collection/v1\"\n\n# folders preparing\nos.makedirs(IMAGES_DIR, exist_ok=True)\n\n# search for object ID\nprint(\"Searching Met Museum collection...\")\nsearch_params = {\n    \"q\": SEARCH_QUERY,\n    \"hasImages\": \"true\",\n    \"departmentId\": DEPARTMENT_ID\n}\nsearch_response = requests.get(f\"{BASE_URL}/search\", params=search_params)\nsearch_response.raise_for_status()\nobject_ids = search_response.json().get(\"objectIDs\", [])\n\nif not object_ids:\n    raise ValueError(\"مفيش نتائج - جربي تغيري SEARCH_QUERY أو DEPARTMENT_ID\")\n\nprint(f\"Found {len(object_ids)} candidate objects. Fetching details for first batch...\")\n\n# ============ الخطوة 2: جيب تفاصيل كل لوحة + حمّل الصورة ============\nartworks = []\nchecked = 0\n\nfor obj_id in object_ids:\n    if len(artworks) >= NUM_ARTWORKS:\n        break\n    checked += 1\n\n    try:\n        detail_response = requests.get(f\"{BASE_URL}/objects/{obj_id}\")\n        detail_response.raise_for_status()\n        data = detail_response.json()\n    except requests.RequestException as e:\n        print(f\"  Skipped object {obj_id}: {e}\")\n        continue\n\n    image_url = data.get(\"primaryImage\")\n    title = data.get(\"title\")\n\n    # نتخطى أي حاجة من غير صورة أو من غير عنوان\n    if not image_url or not title:\n        continue\n\n    # download the photos\n    image_filename = f\"{obj_id}.jpg\"\n    image_path = os.path.join(IMAGES_DIR, image_filename)\n    try:\n        img_data = requests.get(image_url, timeout=15).content\n        with open(image_path, \"wb\") as f:\n            f.write(img_data)\n    except requests.RequestException as e:\n        print(f\"  Failed to download image for object {obj_id}: {e}\")\n        continue\n\n    artwork_entry = {\n        \"id\": obj_id,\n        \"name\": title,\n        \"artist\": data.get(\"artistDisplayName\") or \"Unknown\",\n        \"year\": data.get(\"objectDate\") or \"Unknown\",\n        \"style\": data.get(\"classification\") or \"\",\n        \"materials\": data.get(\"medium\") or \"\",\n        \"culture\": data.get(\"culture\") or \"\",\n        \"department\": data.get(\"department\") or \"\",\n        \"dimensions\": data.get(\"dimensions\") or \"\",\n        \"credit_line\": data.get(\"creditLine\") or \"\",\n        \"image_file\": image_filename,\n        \"image_url\": image_url,\n        # الحقول دي فاضية دلوقتي - هنملاها لاحقًا يدويًا أو عن طريق الـ LLM مرة واحدة\n        \"story\": \"\",\n        \"symbols\": \"\",\n        \"artist_bio\": \"\",\n        \"historical_context\": \"\"\n    }\n\n    artworks.append(artwork_entry)\n    print(f\"  [{len(artworks)}/{NUM_ARTWORKS}] Saved: {title} ({artwork_entry['artist']})\")\n\n    time.sleep(0.2)  # عشان ما نضغطش على الـ API بسرعة كبيرة\n\nprint(f\"\\nChecked {checked} objects, saved {len(artworks)} artworks with images.\")\n\n# ============ الخطوة 3: سيفي الـ JSON ============\nwith open(JSON_PATH, \"w\", encoding=\"utf-8\") as f:\n    json.dump(artworks, f, ensure_ascii=False, indent=2)\n\nprint(f\"\\nDone! Data saved to: {JSON_PATH}\")\nprint(f\"Images saved to: {IMAGES_DIR}/\")\nprint(\"\\nNext step: افتحي الـ JSON واملي الحقول الفاضية (story, symbols, artist_bio, historical_context)\")\nprint(\"ممكن تعمليها يدوي لكل لوحة أو تستخدمي الـ LLM بتاعك يولدها مرة واحدة وتسيفيها.\")","metada